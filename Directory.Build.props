<Project>

  <!--
    Shared MSBuild properties for every project in the solution.
    CONVENTIONS.md §2: net10.0, nullable, implicit usings and warnings-as-errors are
    set here and never per-project. ARCHITECTURE.md §10: no project targets anything
    else and no project overrides LangVersion.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
