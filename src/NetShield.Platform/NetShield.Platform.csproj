<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform supplies endpoint-shaped primitives (Result mapping, problem details) to the
       composition root, so it compiles against the shared framework rather than pulling the
       ASP.NET Core packages in one at a time. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetShield.Contracts\NetShield.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetShield.UnitTests" />
    <InternalsVisibleTo Include="NetShield.IntegrationTests" />
  </ItemGroup>

</Project>
