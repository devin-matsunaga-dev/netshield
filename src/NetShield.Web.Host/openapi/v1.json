            ]
          },
          "osVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "serialNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "site": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/DeviceRole"
          },
          "criticality": {
            "$ref": "#/components/schemas/CriticalityTier"
          },
          "environment": {
            "$ref": "#/components/schemas/DeviceEnvironment"
          },
          "owner": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": [
              "null",
