          },
          "environment": {
            "$ref": "#/components/schemas/DeviceEnvironment"
          },
          "owner": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeviceEnvironment": {
        "type": "integer"
      },
      "DeviceRole": {
        "type": "integer"
      },
      "DeviceState": {
        "type": "integer"
      },
      "DeviceSummary": {
        "required": [
          "id",
          "hostname",
          "primaryIpAddress",
          "vendor",
          "model",
          "role",
          "site",
          "criticality",
          "environment",
          "state",
          "tags",
          "updatedAt"
