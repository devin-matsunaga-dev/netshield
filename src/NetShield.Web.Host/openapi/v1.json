          "vendor",
          "model",
          "osVersion",
          "serialNumber",
          "site",
          "role",
          "criticality",
          "environment",
          "owner",
          "tags",
          "notes",
          "state",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
